.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# Testing & browser automation logs
/coverage
*.lcov
/.playwright-mcp/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log

# OS metadata & temporary files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# Editor & IDE files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local agent & tooling state
.claude/settings.local.json

# Vercel
.vercel

# TypeScript build info and generated types
*.tsbuildinfo
next-env.d.ts
